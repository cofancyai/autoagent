# Application
APP_NAME=ThinkingAgent
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thinkingagent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API (Anthropic or OpenRouter)
# For Anthropic: Use your Anthropic API key
# For OpenRouter: Use your OpenRouter API key (starts with sk-or-v1-)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OpenRouter model (only used if ANTHROPIC_API_KEY is an OpenRouter key)
OPENROUTER_MODEL=qwen/qwen3-coder:free

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Configuration
LLM_DEFAULT_MODEL=sonnet
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_ENABLE_PROMPT_CACHING=True

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=50
RATE_LIMIT_TOKENS_PER_MINUTE=40000

# Cost Limits
DAILY_COST_LIMIT=50.00
MONTHLY_COST_LIMIT=1000.00

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
